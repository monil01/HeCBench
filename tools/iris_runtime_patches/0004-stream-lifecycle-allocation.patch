+/* Quiescent controls. These wait for submitted IRIS work before changing state.
+ * A stream slot must be empty before creation; destroy rejects live async
+ * allocations tied to that slot. Destroyed slots must not be submitted to. */
+extern int iris_set_malloc_async(int enabled);
+extern int iris_hip_stream_create(int device, int index, int nonblocking);
+extern int iris_hip_stream_destroy(int device, int index);
+/* Eight uint64 counters: stream creates/destroys, async allocs/frees,
+ * legacy-device allocs/frees, physical H2D calls/bytes. Optional atomic reset. */
+extern int iris_hip_lifecycle_stats(int device, uint64_t *values, int reset);
+
--- a/src/runtime/CAPI.cpp
+++ b/src/runtime/CAPI.cpp
@@ -234,0 +235,34 @@
+int iris_set_malloc_async(int enabled) {
+  if (enabled != 0 && enabled != 1) return IRIS_ERROR;
+  Platform *platform = Platform::GetPlatform();
+  if (platform->Synchronize() != IRIS_SUCCESS) return IRIS_ERROR;
+  platform->set_malloc_async_flag(enabled);
+  return IRIS_SUCCESS;
+}
+
+static DeviceHIP *lifecycle_device(int device) {
+  Platform *platform = Platform::GetPlatform();
+  if (device < 0 || device >= platform->ndevs()) return NULL;
+  Device *dev = platform->device(device);
+  return dev && dev->model() == iris_hip ? static_cast<DeviceHIP *>(dev) : NULL;
+}
+
+int iris_hip_stream_create(int device, int index, int nonblocking) {
+  DeviceHIP *dev = lifecycle_device(device);
+  if (!dev || Platform::GetPlatform()->Synchronize() != IRIS_SUCCESS) return IRIS_ERROR;
+  return dev->CreateStreamSlot(index, nonblocking);
+}
+
+int iris_hip_stream_destroy(int device, int index) {
+  DeviceHIP *dev = lifecycle_device(device);
+  if (!dev || Platform::GetPlatform()->Synchronize() != IRIS_SUCCESS) return IRIS_ERROR;
+  return dev->DestroyStreamSlot(index);
+}
+
+int iris_hip_lifecycle_stats(int device, uint64_t *values, int reset) {
+  DeviceHIP *dev = lifecycle_device(device);
+  if (!dev || !values || (reset != 0 && reset != 1)) return IRIS_ERROR;
+  if (Platform::GetPlatform()->Synchronize() != IRIS_SUCCESS) return IRIS_ERROR;
+  return dev->LifecycleStats(values, reset != 0);
+}
+
