@@ -173,0 +174,36 @@
+int DeviceHIP::LifecycleStats(uint64_t *values, bool reset) {
+  for (int i = 0; i < 8; ++i)
+    values[i] = reset ? lifecycle_[i].exchange(0) : lifecycle_[i].load();
+  return IRIS_SUCCESS;
+}
+
+int DeviceHIP::CreateStreamSlot(int index, int nonblocking) {
+  if (!is_async(false) || index < 0 || index >= nqueues_ || streams_[index] ||
+      (nonblocking != 0 && nonblocking != 1)) return IRIS_ERROR;
+  if (ld_->hipCtxSetCurrent(ctx_) != hipSuccess) return IRIS_ERROR;
+  hipStream_t stream = NULL;
+  if (ld_->hipStreamCreateWithPriority(&stream, nonblocking ? 1 : 0, 0) != hipSuccess)
+    return IRIS_ERROR;
+  streams_[index] = stream;
+  if (index >= n_copy_engines_)
+    streams_[index+nqueues_-n_copy_engines_] = stream;
+  ++lifecycle_[0];
+  return IRIS_SUCCESS;
+}
+
+int DeviceHIP::DestroyStreamSlot(int index) {
+  if (!is_async(false) || index < 0 || index >= nqueues_ || !streams_[index])
+    return IRIS_ERROR;
+  std::lock_guard<std::mutex> lock(allocation_streams_mutex_);
+  for (const auto &allocation : allocation_streams_)
+    if (allocation.second == index) return IRIS_ERROR;
+  if (ld_->hipCtxSetCurrent(ctx_) != hipSuccess) return IRIS_ERROR;
+  if (ld_->hipStreamSynchronize(streams_[index]) != hipSuccess) return IRIS_ERROR;
+  if (ld_->hipStreamDestroy(streams_[index]) != hipSuccess) return IRIS_ERROR;
+  streams_[index] = NULL;
+  if (index >= n_copy_engines_)
+    streams_[index+nqueues_-n_copy_engines_] = NULL;
+  ++lifecycle_[1];
+  return IRIS_SUCCESS;
+}
