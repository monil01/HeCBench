@@ -154,0 +155,19 @@
+int DeviceHIP::SetStreamPriority(int index, int priority) {
+  if (!is_async(false) || index < 0 || index >= nqueues_ || !streams_[index]) return IRIS_ERROR;
+  hipError_t error = ld_->hipCtxSetCurrent(ctx_);
+  if (error != hipSuccess) return IRIS_ERROR;
+  hipStream_t replacement = NULL;
+  error = ld_->hipStreamCreateWithPriority(&replacement, 1 /* nonblocking */, priority);
+  if (error != hipSuccess) return IRIS_ERROR;
+  error = ld_->hipStreamSynchronize(streams_[index]);
+  if (error == hipSuccess) error = ld_->hipStreamDestroy(streams_[index]);
+  if (error != hipSuccess) {
+    ld_->hipStreamDestroy(replacement);
+    return IRIS_ERROR;
+  }
+  streams_[index] = replacement;
+  if (index >= n_copy_engines_)
+    streams_[index+nqueues_-n_copy_engines_] = replacement;
+  return IRIS_SUCCESS;
+}
