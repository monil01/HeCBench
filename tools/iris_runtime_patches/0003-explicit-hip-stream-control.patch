+int iris_task_set_stream_index(iris_task handle, int index) {
+ Task *task = Platform::GetPlatform()->get_task_object(handle);
+ if (!task || task->status() != IRIS_NONE || index < 0 ||
+     index >= Platform::GetPlatform()->nstreams()) return IRIS_ERROR;
+ task->set_stream_policy(STREAM_POLICY_SAME_FOR_TASK);
+ task->set_recommended_stream(index);
+ return IRIS_SUCCESS;
+}
+
+int iris_hip_set_stream_priority(int device, int index, int priority) {
+ Platform *platform = Platform::GetPlatform();
+ if (device < 0 || device >= platform->ndevs()) return IRIS_ERROR;
+ Device *dev = platform->device(device);
+ if (!dev || dev->model() != iris_hip) return IRIS_ERROR;
+ return static_cast<DeviceHIP *>(dev)->SetStreamPriority(index, priority);
