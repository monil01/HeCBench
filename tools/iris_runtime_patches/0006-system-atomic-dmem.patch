--- a/include/iris/iris_runtime.h
+++ b/include/iris/iris_runtime.h
@@ -1577,0 +1578,10 @@
+/* Quiescent fresh contiguous 1-D DMem root (no tiles), null original host
+ * pointer, HIP allocation kind 2
+ * only. Materialize DMem-owned coherent pinned storage and borrow its host
+ * address. The caller must not free it, enable USM, change its host binding,
+ * clear the DMem, or use other devices while borrowing. Initialize through the
+ * view before submitting tasks, use atomic operations for concurrent access,
+ * and wait for all work before release. DMem retains allocation ownership.
+ */
+extern int iris_dmem_bind_hip_shared_view(iris_mem mem, int device, void** pointer);
+
--- a/src/runtime/CAPI.cpp
+++ b/src/runtime/CAPI.cpp
@@ -203,0 +204,11 @@
+int iris_dmem_bind_hip_shared_view(iris_mem handle, int device, void** pointer) {
+ Platform* platform = Platform::GetPlatform();
+ if (!pointer || device < 0 || device >= platform->ndevs()) return IRIS_ERROR;
+ *pointer = NULL;
+ BaseMem* mem = platform->get_mem_object(handle);
+ if (!mem || mem->GetMemHandlerType() != IRIS_DMEM ||
+     platform->device(device)->model() != iris_hip) return IRIS_ERROR;
+ if (platform->Synchronize() != IRIS_SUCCESS) return IRIS_ERROR;
+ return static_cast<DataMem*>(mem)->BindHIPSharedView(platform->device(device), pointer);
+}
+
--- a/src/runtime/DataMem.h
+++ b/src/runtime/DataMem.h
@@ -36,0 +37 @@
+  int BindHIPSharedView(Device* dev, void** pointer);
--- a/src/runtime/DataMem.cpp
+++ b/src/runtime/DataMem.cpp
@@ -246,0 +247,19 @@
+int DataMem::BindHIPSharedView(Device* dev, void** pointer)
+{
+    // Quiescent, fresh root only. Unlike USM this allocation remains owned by
+    // DMem and must still reach DeviceHIP::MemFree / hipHostFree on teardown.
+    if (!pointer || !dev || source_mem_ || regions_ || host_ptr_ ||
+        dim_ != 1 || tile_enabled_ ||
+        size_ == 0 || hip_allocation_kind() != 2) return IRIS_ERROR;
+    for (int i = 0; i < ndevs_; ++i)
+        if (archs_[i] || is_usm(i)) return IRIS_ERROR;
+    void* allocation = arch(dev);
+    if (!allocation) return IRIS_ERROR;
+    host_ptr_ = allocation;
+    host_ptr_owner_ = false;
+    host_dirty_flag_ = false;
+    set_dirty_except(dev->devno());
+    *pointer = allocation;
+    return IRIS_SUCCESS;
+}
+
