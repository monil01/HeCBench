+int iris_dmem_set_hip_allocation_kind(iris_mem handle, int kind) {
+ BaseMem *mem = Platform::GetPlatform()->get_mem_object(handle);
+ if (!mem || mem->GetMemHandlerType() != IRIS_DMEM || kind < 0 || kind > 2) return IRIS_ERROR;
+ for (int i = 0; i < Platform::GetPlatform()->ndevs(); ++i)
+   if (mem->get_arch(i) != NULL || mem->is_usm(i)) return IRIS_ERROR;
+ mem->set_hip_allocation_kind(kind);
+ return IRIS_SUCCESS;
+}
