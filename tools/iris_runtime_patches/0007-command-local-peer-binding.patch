+bool Task::valid_remote_dmem_composition() {
+  bool remote = false;
+  for (Command* cmd : cmds_) remote = remote || cmd->has_remote_dmem();
+  if (remote && ncmds_kernel() != 1) return false;
+  for (Task* child : subtasks_)
+    if (!child->valid_remote_dmem_composition()) return false;
+  return true;
+}
