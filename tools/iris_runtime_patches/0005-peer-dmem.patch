@@ -154,0 +155,42 @@
+int DeviceHIP::EnablePeerTo(DeviceHIP *peer) {
+  if (!peer || peer == this || !ctx_ || !peer->ctx_) return IRIS_ERROR;
+  int supported = 0;
+  hipError_t error = ld_->hipDeviceCanAccessPeer(&supported, dev_, peer->dev_);
+  if (error != hipSuccess || !supported) return IRIS_ERROR;
+  error = ld_->hipCtxSetCurrent(ctx_);
+  if (error != hipSuccess) return IRIS_ERROR;
+  error = ld_->hipCtxEnablePeerAccess(peer->ctx_, 0);
+  // HIP ABI: 704 is hipErrorPeerAccessAlreadyEnabled (not in bundled subset).
+  return error == hipSuccess || static_cast<int>(error) == 704 ? IRIS_SUCCESS : IRIS_ERROR;
+}
+
+int DeviceHIP::CopyPeer(DataMem *destination, DeviceHIP *source_device,
+                        DataMem *source, size_t bytes) {
+  void *src = source->get_arch(source_device->devno());
+  if (!src || source->is_dev_dirty(source_device->devno())) {
+    fprintf(stderr, "peer source unavailable: device=%d pointer=%p dirty=%d\n",
+            source_device->devno(), src, source->is_dev_dirty(source_device->devno()));
+    return IRIS_ERROR;
+  }
+  void *dst = destination->arch(this);
+  if (!dst) { fprintf(stderr, "peer destination unavailable\n"); return IRIS_ERROR; }
+  hipError_t context_status = ld_->hipCtxSetCurrent(ctx_);
+  if (context_status != hipSuccess) {
+    fprintf(stderr, "peer context status=%d\n", (int)context_status); return IRIS_ERROR;
+  }
+  hipError_t error = ld_->hipMemcpyPeer(dst, dev_, src, source_device->dev_, bytes);
+  if (error != hipSuccess) {
+    fprintf(stderr, "HIP peer copy status=%d source=%d destination=%d\n", (int)error,
+            source_device->dev_, dev_);
+    return IRIS_ERROR;
+  }
+  hipError_t synchronize_status = ld_->hipDeviceSynchronize();
+  if (synchronize_status != hipSuccess) {
+    fprintf(stderr, "peer synchronize status=%d\n", (int)synchronize_status); return IRIS_ERROR;
+  }
+  destination->set_dirty_except(devno());
+  destination->set_host_dirty();
+  destination->disable_reset();
+  return IRIS_SUCCESS;
+}
