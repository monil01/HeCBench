+/* Synchronous HIP peer operations. Callers must complete earlier producers.
+ * Remote bindings are read-only root DMem arguments; they suppress migration
+ * and execute synchronously. All storage and kernel dispatch remain in IRIS. */
+extern int iris_hip_enable_peer_access(int device, int peer);
+extern int iris_task_bind_hip_remote_dmem(iris_task task, int argument, int source_device);
+extern int iris_dmem_peer_copy(iris_mem destination, int destination_device,
+                              iris_mem source, int source_device, size_t bytes);
+/* Non-materializing query: 1 allocated, 0 absent, IRIS_ERROR on invalid input. */
+extern int iris_dmem_is_allocated_on_device(iris_mem memory, int device);
+
--- a/src/runtime/CAPI.cpp
+++ b/src/runtime/CAPI.cpp
@@ -274,0 +275,48 @@
+int iris_hip_enable_peer_access(int device, int peer) {
+  DeviceHIP *owner = lifecycle_device(device), *other = lifecycle_device(peer);
+  if (!owner || !other || owner == other) return IRIS_ERROR;
+  if (Platform::GetPlatform()->Synchronize() != IRIS_SUCCESS) return IRIS_ERROR;
+  return owner->EnablePeerTo(other);
+}
+
+int iris_task_bind_hip_remote_dmem(iris_task handle, int argument, int source_device) {
+  Platform *platform = Platform::GetPlatform();
+  Task *task = platform->get_task_object(handle);
+  if (!task || task->status() != IRIS_NONE || !lifecycle_device(source_device)) return IRIS_ERROR;
+  Command *cmd = task->cmd_kernel();
+  if (!cmd || argument < 0 || argument >= cmd->kernel_nargs()) return IRIS_ERROR;
+  KernelArg *arg = cmd->kernel_arg(argument);
+  if (!arg->mem || arg->mode != iris_r || arg->mem->GetMemHandlerType() != IRIS_DMEM ||
+      !arg->mem->get_arch(source_device) ||
+      static_cast<DataMem *>(arg->mem)->is_dev_dirty(source_device)) return IRIS_ERROR;
+  cmd->bind_remote_dmem(argument, source_device);
+  task->set_async(false);
+  return IRIS_SUCCESS;
+}
+
+int iris_dmem_peer_copy(iris_mem dst_handle, int dst_device,
+                        iris_mem src_handle, int src_device, size_t bytes) {
+  Platform *platform = Platform::GetPlatform();
+  DeviceHIP *dst = lifecycle_device(dst_device), *src = lifecycle_device(src_device);
+  BaseMem *destination = platform->get_mem_object(dst_handle);
+  BaseMem *source = platform->get_mem_object(src_handle);
+  if (!dst || !src || dst == src || !destination || !source || destination == source ||
+      destination->GetMemHandlerType() != IRIS_DMEM || source->GetMemHandlerType() != IRIS_DMEM ||
+      !bytes || bytes != source->size() || bytes != destination->size()) {
+    fprintf(stderr, "peer arguments invalid: devices=%d,%d bytes=%zu sizes=%zu,%zu\n",
+            src_device, dst_device, bytes, source ? source->size() : 0,
+            destination ? destination->size() : 0);
+    return IRIS_ERROR;
+  }
+  if (platform->Synchronize() != IRIS_SUCCESS) return IRIS_ERROR;
+  return dst->CopyPeer(static_cast<DataMem *>(destination), src, static_cast<DataMem *>(source), bytes);
+}
+
+int iris_dmem_is_allocated_on_device(iris_mem handle, int device) {
+  Platform *platform = Platform::GetPlatform();
+  if (device < 0 || device >= platform->ndevs()) return IRIS_ERROR;
+  BaseMem *memory = platform->get_mem_object(handle);
+  if (!memory || memory->GetMemHandlerType() != IRIS_DMEM) return IRIS_ERROR;
+  return memory->get_arch(device) != NULL ? 1 : 0;
+}
