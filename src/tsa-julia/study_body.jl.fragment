 for part in 0:(BY÷32-1)
  @inbounds cr[part+1],ci[part+1]=tsa_pair(a,b,cr[part+1],ci[part+1],sx,sy+Int32(32part),checker_y+Int32(32part),w,h,rl,im,Val(BY),Val(1),Val(0))
 end
