+// Corrected study scan: each independent worker owns one entire scan line.
+// Serial ordered prefixes remove the original in-place inter-thread race.
+__global__ void img_integration_kernel(double* d_img,const int nPixX,const int nPixY,const bool direction,const int offsetX,const int offsetY,const int nSlices){
+ const int lane=blockIdx.x*blockDim.x+threadIdx.x;
+ const int lines=direction==integrateXcoord?nPixY:nPixX;
+ if(lane>=lines*nSlices)return;
+ const int slice=lane/lines;const int line=lane%lines;double acc=0;
+ if(direction==integrateXcoord){for(int x=0;x<nPixX;x++){int pos=slice*nPixX*nPixY+x*nPixY+line;acc+=d_img[pos];d_img[pos]=acc;}}
+ else{for(int y=0;y<nPixY;y++){int pos=slice*nPixX*nPixY+line*nPixY+y;acc+=d_img[pos];d_img[pos]=acc;}}
 }
 
