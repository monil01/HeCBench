# Mojo GPU port of the `aes` HeCBench benchmark (simplified).
#
# The upstream benchmark loads a bitmap image; this port mirrors the
# aes-julia / aes-triton simplifications: run a single-round AES-like
# SBOX substitution `out[i] = sbox[in[i] ^ key[i&15]]`, then decrypt
# with the inverse SBOX and check that the round trip recovers input.
#
# Usage: main.mojo <iterations> [decrypt_flag]

from std.gpu.host import DeviceContext
from std.gpu import thread_idx, block_idx, block_dim
from std.memory import UnsafePointer
from std.sys import argv, exit
from std.time import perf_counter_ns


def encrypt_kernel(
        out_p: UnsafePointer[UInt8, MutAnyOrigin],
        in_p:  UnsafePointer[UInt8, MutAnyOrigin],
        key:   UnsafePointer[UInt8, MutAnyOrigin],
        sbox:  UnsafePointer[UInt8, MutAnyOrigin],
        n: Int32):
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i >= Int(n): return
    var x = in_p[i] ^ key[i & 15]
    out_p[i] = sbox[Int(x)]


def decrypt_kernel(
        out_p: UnsafePointer[UInt8, MutAnyOrigin],
        in_p:  UnsafePointer[UInt8, MutAnyOrigin],
        key:   UnsafePointer[UInt8, MutAnyOrigin],
        isbox: UnsafePointer[UInt8, MutAnyOrigin],
        n: Int32):
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i >= Int(n): return
    var s = isbox[Int(in_p[i])]
    out_p[i] = s ^ key[i & 15]


def sbox_table() -> List[UInt8]:
    var s: List[UInt8] = [
        0x63,0x7C,0x77,0x7B,0xF2,0x6B,0x6F,0xC5,0x30,0x01,0x67,0x2B,0xFE,0xD7,0xAB,0x76,
        0xCA,0x82,0xC9,0x7D,0xFA,0x59,0x47,0xF0,0xAD,0xD4,0xA2,0xAF,0x9C,0xA4,0x72,0xC0,
        0xB7,0xFD,0x93,0x26,0x36,0x3F,0xF7,0xCC,0x34,0xA5,0xE5,0xF1,0x71,0xD8,0x31,0x15,
        0x04,0xC7,0x23,0xC3,0x18,0x96,0x05,0x9A,0x07,0x12,0x80,0xE2,0xEB,0x27,0xB2,0x75,
        0x09,0x83,0x2C,0x1A,0x1B,0x6E,0x5A,0xA0,0x52,0x3B,0xD6,0xB3,0x29,0xE3,0x2F,0x84,
        0x53,0xD1,0x00,0xED,0x20,0xFC,0xB1,0x5B,0x6A,0xCB,0xBE,0x39,0x4A,0x4C,0x58,0xCF,
        0xD0,0xEF,0xAA,0xFB,0x43,0x4D,0x33,0x85,0x45,0xF9,0x02,0x7F,0x50,0x3C,0x9F,0xA8,
        0x51,0xA3,0x40,0x8F,0x92,0x9D,0x38,0xF5,0xBC,0xB6,0xDA,0x21,0x10,0xFF,0xF3,0xD2,
        0xCD,0x0C,0x13,0xEC,0x5F,0x97,0x44,0x17,0xC4,0xA7,0x7E,0x3D,0x64,0x5D,0x19,0x73,
        0x60,0x81,0x4F,0xDC,0x22,0x2A,0x90,0x88,0x46,0xEE,0xB8,0x14,0xDE,0x5E,0x0B,0xDB,
        0xE0,0x32,0x3A,0x0A,0x49,0x06,0x24,0x5C,0xC2,0xD3,0xAC,0x62,0x91,0x95,0xE4,0x79,
        0xE7,0xC8,0x37,0x6D,0x8D,0xD5,0x4E,0xA9,0x6C,0x56,0xF4,0xEA,0x65,0x7A,0xAE,0x08,
        0xBA,0x78,0x25,0x2E,0x1C,0xA6,0xB4,0xC6,0xE8,0xDD,0x74,0x1F,0x4B,0xBD,0x8B,0x8A,
        0x70,0x3E,0xB5,0x66,0x48,0x03,0xF6,0x0E,0x61,0x35,0x57,0xB9,0x86,0xC1,0x1D,0x9E,
        0xE1,0xF8,0x98,0x11,0x69,0xD9,0x8E,0x94,0x9B,0x1E,0x87,0xE9,0xCE,0x55,0x28,0xDF,
        0x8C,0xA1,0x89,0x0D,0xBF,0xE6,0x42,0x68,0x41,0x99,0x2D,0x0F,0xB0,0x54,0xBB,0x16
    ]
    return s^


def main() raises:
    var args = argv()
    var iters = Int(atol(args[1])) if len(args) > 1 else 100
    var W = 512
    var H = 512
    var N = W * H
    print("Image width and height:", W, H)

    var ctx = DeviceContext()
    var d_inp  = ctx.enqueue_create_buffer[DType.uint8](N)
    var d_enc  = ctx.enqueue_create_buffer[DType.uint8](N)
    var d_dec  = ctx.enqueue_create_buffer[DType.uint8](N)
    var d_key  = ctx.enqueue_create_buffer[DType.uint8](16)
    var d_sbox = ctx.enqueue_create_buffer[DType.uint8](256)
    var d_isbox = ctx.enqueue_create_buffer[DType.uint8](256)

    var sbox = sbox_table()
    var isbox = List[UInt8](length=256, fill=UInt8(0))
    for i in range(256):
        isbox[Int(sbox[i])] = UInt8(i)

    var s: UInt64 = 20260721
    with d_inp.map_to_host() as ih, d_key.map_to_host() as kh,\
         d_sbox.map_to_host() as sh, d_isbox.map_to_host() as ish:
        for i in range(N):
            s = s * UInt64(6364136223846793005) + UInt64(1442695040888963407)
            ih[i] = UInt8(Int(s >> 33) & 0xff)
        for i in range(16):
            kh[i] = UInt8((i * 37 + 13) & 0xff)
        for i in range(256):
            sh[i] = sbox[i]
            ish[i] = isbox[i]

    comptime BLOCK: Int = 256
    var blocks = (N + BLOCK - 1) // BLOCK

    ctx.synchronize()
    var t0 = perf_counter_ns()
    for _ in range(iters):
        ctx.enqueue_function[func=encrypt_kernel](
            d_enc.unsafe_ptr(), d_inp.unsafe_ptr(),
            d_key.unsafe_ptr(), d_sbox.unsafe_ptr(),
            Int32(N), grid_dim=blocks, block_dim=BLOCK)
    ctx.synchronize()
    var us = Float64(perf_counter_ns() - t0) / 1e3 / Float64(iters)
    print("Average kernel execution time:", us, "(us)")

    ctx.enqueue_function[func=decrypt_kernel](
        d_dec.unsafe_ptr(), d_enc.unsafe_ptr(),
        d_key.unsafe_ptr(), d_isbox.unsafe_ptr(),
        Int32(N), grid_dim=blocks, block_dim=BLOCK)
    ctx.synchronize()

    var ok = True
    with d_dec.map_to_host() as dh, d_inp.map_to_host() as ih:
        for i in range(N):
            if dh[i] != ih[i]:
                if ok:
                    print("Mismatch at", i, "enc/dec=", dh[i], "orig=", ih[i])
                ok = False
    if ok:
        print("PASS")
    else:
        print("FAIL")
