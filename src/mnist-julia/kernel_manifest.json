    "N": "3456",
    "body": "ch=n%6;r=div(n,6)%24;c=div(n,144)%24;i=(ch*24+r)*24+c+1;o=1f0/(1f0+exp(-preact[i]))\n  dpreact[i]=doutput[i]*o*(1f0-o)"
  },
  {
    "name": "bp_weight_c1",
    "args": "dweight,dpreact,poutput",
    "N": "86400",
    "body": "ch=n%6;kr=div(n,6)%5;kc=div(n,30)%5;r=div(n,150)%24;c=div(n,3600)%24\n  atomic_add!(dweight,(ch*5+kr)*5+kc+1,dpreact[(ch*24+r)*24+c+1]*poutput[(r+kr)*28+c+kc+1]/576f0)"
  },
  {
    "name": "bp_bias_c1",
