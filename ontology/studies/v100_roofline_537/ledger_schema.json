{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Version1 auditable per-stage V100 roofline ledger",
  "type": "object",
  "required": [
    "benchmark",
    "model",
    "configuration_id",
    "outcome",
    "profile_status",
    "identity",
    "scope",
    "arithmetic",
    "memory",
    "ceilings",
    "classification"
  ],
  "properties": {
    "benchmark": {
      "type": "string"
    },
    "model": {
      "enum": [
        "cuda",
        "cuda_jl",
        "ka",
        "jacc"
      ]
    },
    "configuration_id": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "named_numerical",
        "property_equivalence",
        "execution_only",
        "hardware_blocked"
      ]
    },
    "qualification": {
      "type": "string"
    },
    "profile_status": {
      "enum": [
        "measured",
        "partial_coverage",
        "not_applicable_nonFP",
        "not_applicable_no_kernels",
        "not_applicable_no_useful_work",
        "blocked_hardware",
        "failed_profile",
        "missing_metrics",
        "unreviewed"
      ]
    },
    "identity": {
      "type": "object",
      "required": [
        "result_path",
        "result_sha256",
        "config_sha256",
        "executed_source_bindings",
        "profiler_version",
        "profiler_sha256",
        "device_uuid",
        "stage_id",
        "kernel_name",
        "launch_ordinal",
        "geometry",
        "identity_reviewed"
      ],
      "properties": {
        "result_path": {
          "type": "string"
        },
        "result_sha256": {
          "type": "string"
        },
        "config_sha256": {
          "type": "string"
        },
        "executed_source_bindings": {
          "type": "array"
        },
        "profiler_version": {
          "type": "string"
        },
        "profiler_sha256": {
          "type": "string"
        },
        "device_uuid": {
          "type": [
            "string",
            "null"
          ]
        },
        "stage_id": {
          "type": "string"
        },
        "kernel_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "launch_ordinal": {
          "type": [
            "integer",
            "null"
          ]
        },
        "geometry": {
          "type": [
            "object",
            "null"
          ]
        },
        "identity_reviewed": {
          "type": "boolean"
        },
        "library_bindings": {
          "type": "array"
        },
        "raw_counter_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "primary_ROI",
        "profile_ROI",
        "coverage_kind",
        "expected_launches",
        "measured_launches",
        "duration_source",
        "replay_mode",
        "cache_control",
        "clock_control",
        "correctness_scope_unchanged"
      ],
      "properties": {
        "primary_ROI": {
          "type": "string"
        },
        "profile_ROI": {
          "type": "string"
        },
        "coverage_kind": {
          "enum": [
            "complete_stage",
            "complete_device_ROI",
            "complete_workflow",
            "sampled_launch",
            "not_applicable",
            "unknown"
          ]
        },
        "expected_launches": {
          "type": [
            "integer",
            "null"
          ]
        },
        "measured_launches": {
          "type": [
            "integer",
            "null"
          ]
        },
        "duration_source": {
          "enum": [
            "same_launch_device_duration",
            "same_range_elapsed",
            "serial_profile_duration_sum",
            "none"
          ]
        },
        "replay_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "cache_control": {
          "type": [
            "string",
            "null"
          ]
        },
        "clock_control": {
          "type": [
            "string",
            "null"
          ]
        },
        "correctness_scope_unchanged": {
          "type": "boolean"
        },
        "host_and_transfer_exclusions": {
          "type": "array"
        },
        "primary_unprofiled_mean_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "profile_duration_seconds": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "arithmetic": {
      "type": "object",
      "required": [
        "storage_precision",
        "timed_compute_precision",
        "raw_predicated_on_thread_instruction_counts",
        "executed_scalar_flops",
        "tensor_instruction_count",
        "tensor_flops",
        "useful_source_flops",
        "special_function_omissions",
        "formula_provenance"
      ],
      "properties": {
        "storage_precision": {
          "type": "array"
        },
        "timed_compute_precision": {
          "type": "array"
        },
        "raw_predicated_on_thread_instruction_counts": {
          "type": "object"
        },
        "executed_scalar_flops": {
          "type": "object"
        },
        "tensor_instruction_count": {
          "type": [
            "number",
            "null"
          ]
        },
        "tensor_flops": {
          "type": [
            "number",
            "null"
          ]
        },
        "useful_source_flops": {
          "type": [
            "number",
            "null"
          ]
        },
        "special_function_omissions": {
          "type": "array"
        },
        "formula_provenance": {
          "type": "array"
        }
      }
    },
    "memory": {
      "type": "object",
      "required": [
        "dram_read_bytes",
        "dram_write_bytes",
        "L2_transaction_bytes",
        "raw_units",
        "zero_missing_policy"
      ],
      "properties": {
        "dram_read_bytes": {
          "type": [
            "number",
            "null"
          ]
        },
        "dram_write_bytes": {
          "type": [
            "number",
            "null"
          ]
        },
        "L2_transaction_bytes": {
          "type": [
            "number",
            "null"
          ]
        },
        "raw_units": {
          "type": "object"
        },
        "zero_missing_policy": {
          "const": "missing remains null; true zero bytes yields undefined intensity"
        }
      }
    },
    "ceilings": {
      "type": "object",
      "required": [
        "kind",
        "per_precision_flops_per_second",
        "per_tier_bytes_per_second",
        "formulas",
        "evidence"
      ],
      "properties": {
        "kind": {
          "enum": [
            "modeled_theoretical_clock_adjusted",
            "datasheet_theoretical",
            "empirical_calibration",
            "unavailable"
          ]
        },
        "per_precision_flops_per_second": {
          "type": "object"
        },
        "per_tier_bytes_per_second": {
          "type": "object"
        },
        "formulas": {
          "type": "object"
        },
        "evidence": {
          "type": "array"
        }
      }
    },
    "classification": {
      "type": "object",
      "required": [
        "roofline_regime",
        "causal_bottleneck",
        "causal_evidence",
        "mixed_projection_only"
      ],
      "properties": {
        "roofline_regime": {
          "enum": [
            "memory_side",
            "near_ridge",
            "compute_side",
            "undefined_zero_traffic",
            "not_applicable",
            "unknown"
          ]
        },
        "causal_bottleneck": {
          "type": "string"
        },
        "causal_evidence": {
          "type": "array"
        },
        "mixed_projection_only": {
          "type": "boolean"
        }
      }
    }
  },
  "$id": "v100_roofline_537/ledger_schema.json",
  "description": "Envelope schema for reviewed campaign records; classifier output is a per-kernel projection report bound by this envelope, not the full stage ledger."
}
